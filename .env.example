# CamScan needs NO environment variables for its core local-first workflow.
#
# Optional extension points (all disabled by default):
#   CAMSCAN_OCR_PROVIDER=   # "tesseract" (default) or a provider you implement
#   CAMSCAN_REMOTE_OCR_URL= # opt-in only: an OCR service you control
#   CAMSCAN_REMOTE_OCR_KEY= # never committed; server-side only
